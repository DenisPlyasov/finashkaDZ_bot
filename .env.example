# Docker/runtime settings
PORT=8000
ENABLE_BOT=1
ENABLE_WEBAPP=1
NOTIFY_TZ=Europe/Moscow
FA_PY=/usr/bin/python3
FA_TIMEOUT_SEC=8

# Telegram bot / Mini App auth
# Put the Telegram token into ./token.txt
# Production Mini App URL: https://finunischedule.allspace.com.ru
REQUIRED_CHANNEL=@your_channel
REQUIRED_CHANNEL_LINK=https://t.me/your_channel
REQUIRED_CHANNEL_ID=@your_channel
# REQUIRED_CHANNEL is mandatory when ENABLE_WEBAPP=1
# REQUIRED_CHANNEL_LINK and REQUIRED_CHANNEL_ID are mandatory when ENABLE_BOT=1

# Optional integrations
MAIL_PASSWORD=
GOOGLE_CREDS_JSON_B64=
